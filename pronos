<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DIOMANDE PRONO VIP</title>
<style>body{margin:0;background:#080c11;color:#fff;font-family:Arial}header{background:#00ff88;color:#000;padding:12px;text-align:center}header h1{margin:0;font-size:17px}.card{background:#151f2b;margin:12px;border-radius:12px;border:1px solid gold}.match{display:flex;justify-content:space-between;padding:12px;align-items:center}.team{width:30%;text-align:center;font-size:12px}.team img{width:32px}.prono-box{text-align:center;width:40%}.prono-vip{background:linear-gradient(135deg,gold,#ffcc00);color:#000;padding:8px;border-radius:10px;font-weight:900}.cote{font-size:11px;margin-top:4px}</style>
</head>
<body>
<header><h1>💎 DIOMANDE VIP - SCORE EXACT AVANT MATCH</h1><div style="font-size:11px">Prono du Boss • Yopougon Selmer • 05 64 36 95 43</div></header>
<div id="list" style="padding:10px">Chargement de tes pronos...</div>
<script>
let pronosData={};
async function init(){
 try{const r=await fetch('pronos.json?v='+Date.now());pronosData=await r.json();}catch(e){pronosData={}}
 loadESPN();
}
async function loadESPN(){
 let all=[];
 for(let lg of ['eng.1','esp.1','fra.1','ita.1']){
  try{const res=await fetch(`https://site.api.espn.com/apis/site/v2/sports/soccer/${lg}/scoreboard`);const d=await res.json();if(d.events) all=all.concat(d.events);}catch(e){}
 }
 let html='';
 const today=new Date().toISOString().split('T')[0];
 const myPronos=pronosData[today]||[];
 all.slice(0,8).forEach(ev=>{
  const c=ev.competitions[0];const h=c.competitors[0];const a=c.competitors[1];
  const matchName=`${h.team.shortDisplayName} vs ${a.team.shortDisplayName}`;
  // Cherche si tu as fait un prono pour ce match
  let myP=myPronos.find(p=>matchName.toLowerCase().includes(p.match.split(' vs ')[0].toLowerCase())||p.match.toLowerCase().includes(h.team.abbreviation.toLowerCase()));
  let pronoScore=myP?myP.prono:'2-1';let cote=myP?myP.cote:'8.50';let conf=myP?myP.confiance:'90%';
  html+=`<div class="card"><div style="padding:6px 10px;font-size:10px;color:#aaa;display:flex;justify-content:space-between"><span>${ev.shortName}</span><span>${c.status.type.shortDetail}</span></div><div class="match"><div class="team"><img src="${h.team.logo}"><br>${h.team.abbreviation}</div><div class="prono-box"><div style="font-size:18px;font-weight:900">${h.score||0}-${a.score||0}</div><div class="prono-vip">🔮 ${pronoScore}<br><small>Cote ${cote}</small></div><div class="cote">Confiance ${conf} • Avant match</div></div><div class="team"><img src="${a.team.logo}"><br>${a.team.abbreviation}</div></div></div>`;
 });
 if(myPronos.length>0){let vipHtml='<h3 style="color:gold;text-align:center;margin-top:20px">🔥 TES PRONOS VIP DU JOUR</h3>';myPronos.forEach(p=>{vipHtml+=`<div class="card" style="border-color:gold;background:#1f1d0a"><div style="padding:12px;text-align:center"><b>${p.match}</b><br><div style="font-size:24px;color:gold;margin:8px 0">${p.prono} @ ${p.cote}</div><small>Confiance ${p.confiance}</small><br><a href="https://wa.me/2250564369543?text=Je veux VIP ${p.prono}" style="display:inline-block;margin-top:8px;background:#25D366;color:white;padding:8px 16px;border-radius:20px;text-decoration:none;font-size:12px">Commander VIP</a></div></div>`});html=vipHtml+html;}
 document.getElementById('list').innerHTML=html||'Pas de match, mais tes pronos VIP ci-dessous restent affichés';
}
init();
</script>
</body>
</html>
